<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.PandaWave" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/pandawave_color_primary</item>
        <item name="colorPrimaryVariant">@color/pandawave_color_primary_container</item>
        <item name="colorOnPrimary">@color/pandawave_color_on_primary</item>
        <item name="colorSecondary">@color/pandawave_color_secondary</item>
        <item name="colorSecondaryVariant">@color/pandawave_color_secondary_container</item>
        <item name="colorOnSecondary">@color/pandawave_color_on_secondary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.PandaWave.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/pandawave_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/pandawave_ic_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.PandaWave</item>
        <item name="android:windowSplashScreenBehavior">icon_preferred</item>
    </style>

    <style name="Theme.PandaWave.Verification" parent="Theme.PandaWave">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
