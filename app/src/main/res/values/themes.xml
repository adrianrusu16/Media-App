<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.PandaWave" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/mediaapp_color_brand_primary</item>
        <item name="colorPrimaryVariant">@color/mediaapp_color_brand_primary</item>
        <item name="colorOnPrimary">@color/mediaapp_color_brand_on_primary</item>
        <item name="colorSecondary">@color/mediaapp_color_brand_secondary</item>
        <item name="colorSecondaryVariant">@color/mediaapp_color_brand_secondary</item>
        <item name="colorOnSecondary">@color/mediaapp_color_brand_on_secondary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.PandaWave.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/mediaapp_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/mediaapp_ic_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.PandaWave</item>
    </style>
</resources>
